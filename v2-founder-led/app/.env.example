# Server-only. Use a fresh key and never expose it through VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Public Google Sheet containing the governed workbook tabs. Leave blank to use
# the governed local seed while developing.
GOOGLE_SHEET_ID=1EmSjTdmZ92lO16hB0_WN7pZOgDhXg2BYUwDTXpNl2sY
CATALOGUE_REFRESH_SECONDS=0
CATALOGUE_MAX_STALE_MINUTES=0

PORT=8787
APP_ORIGIN=http://localhost:5173

# Frontend production settings. Keep blank for local Vite proxy development.
VITE_API_BASE_URL=
VITE_BASE_PATH=/
