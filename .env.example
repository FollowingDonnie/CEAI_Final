# Required. Publish registry-template/northstar-registry.csv as a read-only CSV.
REGISTRY_CSV_URL=

# Required only for the Decision Guide. Deterministic decisions work without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173
PORT=5173
